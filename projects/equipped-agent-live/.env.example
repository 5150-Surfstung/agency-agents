# The room. Attendees join with the PIN; the presenter drives with the key.
LIVE_ROOM_PIN=1054
LIVE_PRESENTER_KEY=change-me-presenter
LIVE_SESSION_SECRET=change-me-long-random

# The arcade engine. Without this the polls and leads still work; the two AI
# tools show an honest "engine offline" state instead of pretending.
ANTHROPIC_API_KEY=

# Spend guardrails for the AI tools (defaults shown).
LIVE_SPEND_CAP_USD=15
LIVE_DEVICE_MSG_CAP=40

# Email. Without these the kit link and the lead alerts are honest no-ops —
# emailOnline() returns false and nothing claims a message was sent. With
# them, a buyer's name and number reach the agent the moment their assistant
# catches somebody, and /api/selftest reports emailOnline: true.
#
# NEVER put the real key in this file or any file in the repo. It belongs in
# the deployment's own environment settings, which is the only place it is
# both read at runtime and never committed.
#
# RESEND_FROM must be on a domain verified in Resend — an unverified sender
# is accepted by the form and silently refused by the provider.
RESEND_API_KEY=
RESEND_FROM=

# Optional: durable storage. Leave blank to run in-memory (dev / single-node).
# On Vercel (serverless) these are REQUIRED — memory does not survive lambdas.
# Either the service-role key, or the anon key + LIVE_DB_SECRET (the header
# secret the live_* RLS policies check — see supabase/migrations/002).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
LIVE_DB_SECRET=
